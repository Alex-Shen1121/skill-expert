{
  "name": "skill-expert",
  "private": true,
  "version": "1.0.7",
  "license": "MIT",
  "homepage": "https://github.com/Alex-Shen1121/skill-expert#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex-Shen1121/skill-expert.git"
  },
  "bugs": {
    "url": "https://github.com/Alex-Shen1121/skill-expert/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:frontend": "vitest run src",
    "preview": "vite preview",
    "version:check": "node scripts/check-version-consistency.mjs",
    "desktop:identity:check": "node scripts/check-desktop-identity.mjs",
    "cli:identity:check": "node scripts/check-cli-identity.mjs",
    "repository:identity:check": "node scripts/check-repository-identity.mjs",
    "test:repository-identity": "node --test scripts/check-repository-identity.test.mjs",
    "test:workflows": "node --test scripts/github-actions-policy.test.mjs scripts/lightweight-pr-workflow.test.mjs",
    "test:version": "node --test scripts/check-version-consistency.test.mjs scripts/stable-version-policy.test.mjs scripts/version-policy-docs.test.mjs scripts/windows-installer-config.test.mjs scripts/linux-installer-config.test.mjs",
    "test:release": "node --test scripts/prepare-release.test.mjs scripts/changelog-history.test.mjs scripts/main-release-workflow.test.mjs scripts/release-assets.test.mjs scripts/release-binary-version.test.mjs scripts/sign-release-updater.test.mjs scripts/download-draft-release-assets.test.mjs scripts/verify-linux-release.test.mjs scripts/verify-macos-release.test.mjs scripts/formal-release-docs.test.mjs",
    "test:test-package": "node --test scripts/package-assets.test.mjs scripts/test-package-workflow.test.mjs scripts/verify-macos-adhoc.test.mjs",
    "test:upstream-tracking": "node --test scripts/upstream-tracking.test.mjs scripts/upstream-tracking-workflow.test.mjs",
    "test:worktree-baseline": "node --test scripts/worktree-baseline-entrypoint.test.mjs scripts/worktree-baseline.test.mjs scripts/worktree-baseline-preflight.test.mjs scripts/worktree-baseline-recovery.test.mjs scripts/worktree-baseline-sync.test.mjs",
    "test:updater": "node --test scripts/check-updater-trust.test.mjs scripts/verify-updater-signature.test.mjs scripts/verify-updater-metadata.test.mjs scripts/updater-key-recovery.test.mjs scripts/provision-updater.test.mjs scripts/updater-workflow.test.mjs scripts/updater-docs.test.mjs",
    "updater:check": "node scripts/check-updater-trust.mjs",
    "updater:check:production": "node scripts/check-updater-trust.mjs --require-production",
    "updater:provision": "node scripts/provision-updater.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "worktree:baseline": "node scripts/worktree-baseline.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "cli": "node scripts/run-rust-cli.mjs cli",
    "cli:build": "node scripts/run-rust-cli.mjs build",
    "cli:install": "node scripts/run-rust-cli.mjs install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "clsx": "^2.1.1",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
